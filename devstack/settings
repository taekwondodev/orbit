# orbit's DevStack plugin. Enable it after heat and blazar in local.conf:
# the order of the enable_plugin lines decides the actual order of the phases.
define_plugin orbit
plugin_requires orbit heat
plugin_requires orbit blazar

enable_service orbit-api

ORBIT_DIR=${ORBIT_DIR:-$DEST/orbit}
ORBIT_CONF_DIR=${ORBIT_CONF_DIR:-/etc/orbit}
ORBIT_CONF=$ORBIT_CONF_DIR/orbit.conf
ORBIT_UWSGI=orbit.api.wsgi:application
ORBIT_UWSGI_CONF=$ORBIT_CONF_DIR/orbit-api-uwsgi.ini

# Service type in the Keystone catalog. It is not registered with the
# OpenStack service types authority: it is a local choice of the project.
ORBIT_SERVICE_TYPE=${ORBIT_SERVICE_TYPE:-orbit}

# Network the harness connects to the orbs from, as a CIDR. Required in
# local.conf: there is no default, so that no orb is open to the whole
# Internet by omission.
ORBIT_SSH_ALLOWED_CIDR=${ORBIT_SSH_ALLOWED_CIDR:-}
