# orbit's DevStack plugin. Enable it after heat and blazar in local.conf:
# the order of the enable_plugin lines decides the actual order of the phases.
define_plugin orbit
plugin_requires orbit heat
plugin_requires orbit blazar

enable_service orbit-api

ORBIT_DIR=${ORBIT_DIR:-$DEST/orbit}
ORBIT_CONF_DIR=${ORBIT_CONF_DIR:-/etc/orbit}
ORBIT_CONF=$ORBIT_CONF_DIR/orbit.conf
ORBIT_UWSGI=orbit.api.wsgi:application
ORBIT_UWSGI_CONF=$ORBIT_CONF_DIR/orbit-api-uwsgi.ini

# Glance name of the orb image, which the plugin uploads (docs/adr/0010).
ORBIT_IMAGE_NAME=${ORBIT_IMAGE_NAME:-orbit-alpine-3.24.3-aarch64}

# Service type in the Keystone catalog. It is not registered with the
# OpenStack service types authority: it is a local choice of the project.
ORBIT_SERVICE_TYPE=${ORBIT_SERVICE_TYPE:-orbit}

# The lab's egress proxy (docs/adr/0009): Smokescreen on this host, which orbs
# reach external destinations through. Off by default: without it, orbs open
# no outbound connection.
ORBIT_EGRESS_PROXY=$(trueorfalse False ORBIT_EGRESS_PROXY)
ORBIT_EGRESS_PROXY_PORT=${ORBIT_EGRESS_PROXY_PORT:-4750}
# Hostnames the proxy admits, comma-separated.
ORBIT_EGRESS_PROXY_DOMAINS=${ORBIT_EGRESS_PROXY_DOMAINS:-github.com,codeload.github.com,objects.githubusercontent.com,registry.npmjs.org,pypi.org,files.pythonhosted.org,ports.ubuntu.com}
if [[ "$ORBIT_EGRESS_PROXY" == "True" ]]; then
    enable_service orbit-egress-proxy
fi
